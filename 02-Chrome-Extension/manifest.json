{
  "manifest_version": 3,
  "name": "OCR Companion for Migaku",
  "version": "1.6.9",
  "minimum_chrome_version": "116",
  "description": "Unofficial companion for Migaku: local Apple OCR for comics. Use the Mac app to read games and other screen text.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "declarativeNetRequestWithHostAccess",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://*.546457.xyz/*",
    "https://*.acimg.cn/*",
    "https://*.baozimh.com/*",
    "https://*.bzcdn.net/*",
    "https://*.cdndm5.com/*",
    "https://*.dongmanmanhua.cn/*",
    "https://*.globalcomix.com/*",
    "https://*.kkmh.com/*",
    "https://*.pstatic.net/*",
    "https://*.shimolife.com/*"
  ],
  "action": {
    "default_title": "Read page with OCR Companion"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+O"
      },
      "description": "Read page with OCR Companion"
    }
  },
  "optional_host_permissions": [
    "https://manga.bilibili.com/*"
  ],
  "version_name": "1.0.0 beta 9",
  "author": "Baroni Fabio (pentestguru)"
}
